# steward-proxy, STEWARD_TLS=http: a Let's Encrypt certificate over HTTP. Let's Encrypt must reach ports 80 and 443
# from the internet, so Steward is on the internet (docs/guides/access.md, "Your own domain"). STEWARD_DOMAIN comes from
# proxy.env; start.sh checks it first, because {$STEWARD_DOMAIN} is pasted into this file as text.
{
	admin off
	persist_config off
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	servers {
		protocols h1 h2
	}
	# Caddy keeps no access log here, but an error line (a 502 while Steward restarts, say) carries the request. The
	# filter drops the request's address whole, path and query: a search, a book's slug (/b/, /api/b/, /api/books/),
	# a category and a link's token all live there. It also drops the headers and the client address. Steward's own
	# log names the route's template instead (P10). tests/test_proxy_files.py holds every Caddyfile to this block.
	log {
		format filter {
			wrap json
			request>uri delete
			request>headers delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
		}
	}
}

{$STEWARD_DOMAIN} {
	reverse_proxy steward:8420
}
