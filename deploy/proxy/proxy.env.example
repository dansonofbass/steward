# steward-proxy's settings, for the domain and lan profiles of deploy/compose.yml (docs/quickstart/install.md). Copy this file
# to proxy.env beside compose.yml, then chmod 600 proxy.env.
# The name Steward is reached at: a plain host name, no https:// and no port (the host of STEWARD_BASE_URL).
STEWARD_DOMAIN=steward.example.com
# domain profile: how Caddy gets a certificate. dns-cloudflare works on a private address (a Cloudflare API token);
# http needs ports 80 and 443 open to the internet, so Steward is on the internet. The lan profile ignores this line.
STEWARD_TLS=dns-cloudflare
# dns-cloudflare only: a Cloudflare API token with Zone / Zone / Read and Zone / DNS / Edit on that domain's zone only.
CLOUDFLARE_API_TOKEN=
