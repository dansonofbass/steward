# Steward's settings for compose.yml (docs/quickstart/install.md; every setting is in docs/reference/configuration.md). Copy this file to
# .env beside compose.yml, then chmod 600 .env.

# The address you open Steward at. Passkeys are tied to it: choose it before anyone registers one.
#   Tailscale: https://steward.<your tailnet>.ts.net    Your own domain: https://steward.example.com
#   LAN only: https://steward.lan                        This box only: http://localhost:8420
STEWARD_BASE_URL=http://localhost:8420

# One way in, or none for this box only: tailscale, domain or lan (docs/guides/access.md).
# COMPOSE_PROFILES=tailscale
# domain and lan: the address the proxy listens on. 127.0.0.1 is this box only; set this box's LAN address so phones
# on your network can reach it.
# STEWARD_PROXY_BIND=192.168.1.20

# Ask (Claude), with the gateway on this box (docs/guides/gateway.md): add gateway to the way in COMPOSE_PROFILES
# already has, and ollama too for a local model, like COMPOSE_PROFILES=tailscale,gateway,ollama or
# COMPOSE_PROFILES=lan,gateway,ollama. Then uncomment this line.
# STEWARD_GATEWAY_URL=http://gateway:8430

# A GPU for the gateway (docs/guides/gpu.md): use gateway-nvidia or gateway-amd in COMPOSE_PROFILES
# instead of gateway and ollama; each brings its own Ollama. Its gateway is built on this machine, which downloads
# the vendor's libraries: first read their licenses, then accept them here, nvidia or amd. Until then Steward won't
# build or run its GPU gateway. Ollama's images come from Ollama, under Ollama's own license.
# STEWARD_GPU_LICENSE_ACCEPTED=nvidia
# AMD only: the number of this machine's render group (deploy/gateway/detect-gpu.sh prints it).
# STEWARD_RENDER_GID=

# Or set these in Steward: Settings › Get Steward ready. A line here wins, even an empty one.
# The household's time zone, like America/Chicago. Empty: UTC.
# STEWARD_TIMEZONE=

# Backups (docs/guides/backups.md): a copy each day at this local time. Empty turns Steward's own backup off.
# STEWARD_BACKUP_AT=03:00
# Where copies go, inside the container (default /data/backups). Better on another disk: see compose.yml.
# STEWARD_BACKUP_DIR=/backups
# Optional: a Healthchecks-style address, like https://hc-ping.com/<uuid>. Steward fetches it after each good backup,
# and <address>/fail after a bad one. Keep it private: anyone with it can mark your check up or down.
# STEWARD_BACKUP_PING_URL=

# Or set these in Steward: Settings › Get Steward ready. A line here wins, even an empty one.
# Email for invites and password resets: all four of host, user, password and from, or none.
# STEWARD_SMTP_HOST=
# STEWARD_SMTP_PORT=465
# STEWARD_SMTP_USER=
# STEWARD_SMTP_PASSWORD=
# STEWARD_MAIL_FROM=

# Bank feeds: hours between SimpleFIN syncs; 0 turns automatic sync off.
STEWARD_SYNC_HOURS=6
